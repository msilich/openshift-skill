// Optional ACS example; review paths, identity and permissions before use.
// StackRox MCP remains read-only in both profiles. Never use --auto for Day-2.
// Header files and ACS_READ_TOKEN are provisioned outside OpenCode; never print them.
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "ocp_read": {
      "type": "local",
      "command": [
        "{env:OPENSHIFT_MCP_BINARY}",
        "--config",
        "{env:OPENSHIFT_MCP_READ_CONFIG}",
        "--kubeconfig",
        "{env:OPENSHIFT_MCP_READ_KUBECONFIG}",
        "--cluster-provider",
        "disabled"
      ],
      "enabled": true
    },
    "acs_read": {
      "type": "local",
      "command": [
        "{env:ACS_MCP_BINARY}"
      ],
      "enabled": true,
      "environment": {
        "STACKROX_MCP__SERVER__TYPE": "stdio",
        "STACKROX_MCP__CENTRAL__AUTH_TYPE": "static",
        "STACKROX_MCP__CENTRAL__URL": "{env:ACS_CENTRAL_HOST}",
        "STACKROX_MCP__CENTRAL__CA_CERT_PATH": "{env:ACS_CA_FILE}",
        "STACKROX_MCP__CENTRAL__API_TOKEN": "{env:ACS_READ_TOKEN}",
        "STACKROX_MCP__CENTRAL__INSECURE_SKIP_TLS_VERIFY": "false",
        "STACKROX_MCP__CENTRAL__MAX_RETRIES": "0",
        "STACKROX_MCP__GLOBAL__READ_ONLY_TOOLS": "true",
        "STACKROX_MCP__TOOLS__CONFIG_MANAGER__ENABLED": "true",
        "STACKROX_MCP__TOOLS__VULNERABILITY__ENABLED": "true"
      }
    }
  },
  "permission": {
    "*": "deny",
    "skill": {
      "*": "deny",
      "openshift-api": "allow",
      "openshift-docs": "allow",
      "openshift-mcp": "allow",
      "openshift-troubleshooting": "allow",
      "openshift-disconnected": "allow",
      "openshift-gitops": "allow",
      "openshift-upgrade": "allow",
      "openshift-backup-restore": "allow",
      "openshift-devspaces": "allow",
      "openshift-acs": "allow"
    },
    "read": {
      "*": "deny",
      ".agents/skills/**": "allow"
    },
    "grep": "allow",
    "glob": "allow",
    "question": "allow",
    "ocp_read_*": "allow",
    "bash": {
      "*": "deny",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} adm upgrade": "ask",
      "oc-mirror --help": "ask",
      "bash *openshift-api/scripts/collect-discovery.sh *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} api-resources": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} api-resources *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} api-versions": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} auth can-i": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} auth can-i *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} cluster-info": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} describe *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} events *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} explain *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} get *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} logs *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} rollout history *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} rollout status *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} status": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} status *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} top *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} adm inspect *": "ask",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} config current-context": "allow",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} whoami": "allow",
      "oc --kubeconfig {env:OPENSHIFT_MCP_READ_KUBECONFIG} whoami --show-server": "allow",
      "{env:ACS_ROXCTL_BINARY} version": "ask",
      "{env:ACS_ROXCTL_BINARY} --help": "ask",
      "curl -q --silent --show-error --fail-with-body --proto =https --max-redirs 0 --connect-timeout 10 --max-time 60 --write-out %{http_code} --cacert {env:ACS_CA_FILE} --header @{env:ACS_READ_HEADER_FILE} --request GET --url https://{env:ACS_CENTRAL_HOST}/v1/policies/{env:ACS_POLICY_ID}": "ask"
    },
    "doom_loop": "ask",
    "acs_read_*": "deny",
    "acs_read_list_secured_clusters": "allow",
    "acs_read_get_deployments_for_cve": "allow",
    "acs_read_get_nodes_for_cve": "allow",
    "acs_read_get_clusters_with_orchestrator_cve": "allow"
  }
}
